{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "background": true,
      "custom": true,
      "customDuotone": true,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "cosmic-bg",     "name": "Cosmic Black",  "color": "#07060d" },
        { "slug": "cosmic-bg-2",   "name": "Deep Violet",   "color": "#0d0a18" },
        { "slug": "cosmic-bg-3",   "name": "Twilight",      "color": "#15102a" },
        { "slug": "cosmic-rose",   "name": "Rose",          "color": "#ff3d8b" },
        { "slug": "cosmic-rose-2", "name": "Rose Light",    "color": "#ff7ab6" },
        { "slug": "cosmic-violet", "name": "Violet",        "color": "#a855ff" },
        { "slug": "cosmic-violet-2","name": "Violet Light", "color": "#c084ff" },
        { "slug": "cosmic-cyan",   "name": "Cyan",          "color": "#22e0f5" },
        { "slug": "cosmic-gold",   "name": "Gold",          "color": "#ffd27a" },
        { "slug": "cosmic-ink",    "name": "Ink",           "color": "#f7f2ff" },
        { "slug": "cosmic-ink-80", "name": "Ink Soft",      "color": "#cfc6e0" },
        { "slug": "cosmic-ink-60", "name": "Ink Muted",     "color": "#9a90b3" },
        { "slug": "cosmic-ink-40", "name": "Ink Faint",     "color": "#6b6485" }
      ],
      "gradients": [
        { "slug": "cosmic-aurora",    "name": "Cosmic Aurora",
          "gradient": "linear-gradient(100deg,#ff3d8b 0%,#c084ff 45%,#22e0f5 100%)" },
        { "slug": "cosmic-rose-heat", "name": "Rose Heat",
          "gradient": "linear-gradient(135deg,#ff3d8b 0%,#a855ff 100%)" },
        { "slug": "cosmic-twilight",  "name": "Twilight",
          "gradient": "linear-gradient(180deg,#07060d 0%,#15102a 100%)" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "textDecoration": true,
      "textTransform": true,
      "dropCap": false,
      "fontFamilies": [
        { "slug": "cosmic-display", "name": "Cosmic Display", "fontFamily": "'Instrument Serif', 'Cormorant Garamond', serif" },
        { "slug": "cosmic-ui",      "name": "Cosmic UI",      "fontFamily": "'Geist', 'Inter Tight', system-ui, sans-serif" },
        { "slug": "cosmic-mono",    "name": "Cosmic Mono",    "fontFamily": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace" }
      ],
      "fontSizes": [
        { "slug": "sm",  "name": "Small",   "size": "14px" },
        { "slug": "md",  "name": "Medium",  "size": "17px" },
        { "slug": "lg",  "name": "Large",   "size": "24px" },
        { "slug": "xl",  "name": "X-Large", "size": "44px" },
        { "slug": "xxl", "name": "Display", "size": "110px" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vh", "vw"],
      "padding": true,
      "margin": true,
      "blockGap": true,
      "spacingScale": { "operator": "*", "increment": 1.5, "steps": 8, "mediumStep": 16 }
    },
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cosmic-bg)",
      "text": "var(--wp--preset--color--cosmic-ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--cosmic-ui)",
      "fontSize": "17px",
      "lineHeight": "1.55"
    },
    "spacing": {
      "padding": { "top": "0", "right": "0", "bottom": "0", "left": "0" }
    },
    "elements": {
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--cosmic-display)", "fontWeight": "400", "letterSpacing": "-0.02em", "lineHeight": "0.95" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--cosmic-display)", "fontWeight": "400", "letterSpacing": "-0.02em", "lineHeight": "0.98" } },
      "h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--cosmic-display)", "fontWeight": "400", "letterSpacing": "-0.01em", "lineHeight": "1.05" } },
      "h4": { "typography": { "fontFamily": "var(--wp--preset--font-family--cosmic-display)", "fontWeight": "400" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--cosmic-rose-2)" },
        ":hover": { "color": { "text": "var(--wp--preset--color--cosmic-rose)" } }
      },
      "button": {
        "color": { "text": "#ffffff", "background": "var(--wp--preset--gradient--cosmic-rose-heat)" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "26px", "right": "26px" } },
        "typography": { "fontWeight": "600" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-calculator", "title": "Calculator Page", "postTypes": ["page"] },
    { "name": "page-full-width", "title": "Full Width Page", "postTypes": ["page"] }
  ]
}
